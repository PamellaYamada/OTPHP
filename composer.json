{
    "name": "pamellayamada/otphp",
    "description": "Native, ultra-fast, and strictly typed engine for generating, validating, and rendering 2FA Tokens (TOTP/HOTP) in PHP 8.3+.",
    "type": "library",
    "keywords": [
        "php",
        "otphp",
        "totp",
        "2fa",
        "two-factor",
        "authentication",
        "security",
        "google-authenticator",
        "steam-guard",
        "qrcode",
        "svg"
    ],
    "homepage": "https://github.com/pamellayamada/otphp",
    "license": "MIT",
    "authors": [
        {
            "name": "Pamella Yamada de Araújo",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OTPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --do-not-cache-result --testdox",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
