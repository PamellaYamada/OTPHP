{
    "name": "pamellayamada/otphp",
    "description": "Native, ultra-fast, hardened security and strictly typed engine for 2FA Tokens (TOTP/HOTP) with 27 i18n languages in PHP 8.3+.",
    "version": "1.0.5",
    "type": "library",
    "keywords": [
        "php",
        "otphp",
        "totp",
        "hotp",
        "2fa",
        "two-factor",
        "authentication",
        "security",
        "google-authenticator",
        "steam-guard",
        "qrcode",
        "svg",
        "i18n"
    ],
    "homepage": "https://github.com/PamellaYamada/OTPHP",
    "license": "MIT",
    "authors": [
        {
            "name": "Pamella Yamada de Araújo",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "infection/infection": "^0.34.1",
        "laravel/pint": "^1.16",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PamellaYamada\\OTPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PamellaYamada\\OTPHP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit --do-not-cache-result --testdox",
        "test:coverage": "XDEBUG_MODE=coverage php vendor/bin/phpunit --coverage-text",
        "analyse": "php vendor/bin/phpstan analyse -l 8 src",
        "format": "php vendor/bin/pint",
        "check": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
