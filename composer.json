{
    "name": "pamellayamada/otphp",
    "description": "The most comprehensive, high-performance, multi-provider, zero-dependency, and internationalized OTP (TOTP/HOTP) library for PHP 8.1+.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pamella Yamada de Araujo",
            "email": "YamadaPamella@gmail.com",
            "role": "Developer & Maintainer"
        }
    ],
    "keywords": [
        "otphp",
        "otp",
        "totp",
        "hotp",
        "2fa",
        "two-factor",
        "authentication",
        "google-authenticator",
        "yubikey",
        "steam-guard",
        "qrcode",
        "svg",
        "i18n",
        "security"
    ],
    "require": {
        "php": ">=8.1",
        "ext-hash": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "OTPHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OTPHP\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
